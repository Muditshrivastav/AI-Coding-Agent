{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AI Coding Agent Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/vscode-extension/**/*.js"]
    }
  ]
}
