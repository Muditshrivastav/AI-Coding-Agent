{
  "allow": [
    "Read(*)",
    "Read(**/*)",
    "tavily_search*",
    "tavily_web_search*",
    "chrome-devtools*",
    "github_create_issue",
    "github_list_issues",
    "github_create_pr",
    "github_repo_info",
    "github_list_commits",
    "supabase_query",
    "render_service_status",
    "groq_infer",
    "langsmith_recent_runs",
    "probabilistic_decision",
    "execute_command",
    "terminal_run",
    "terminal_read",
    "terminal_close"
  ],
  "ask": [
    "AgentRun(start)",
    "Bash(*)",
    "Edit(*)",
    "Edit(**/*)",
    "Write(*)",
    "Write(**/*)",
    "Delete(*)",
    "Delete(**/*)",
    "vercel_deploy",
    "render_deploy",
    "mcp__github__create_pull_request",
    "mcp__github__merge_pull_request",
    "mcp__github__delete_branch",
    "mcp__github__push_files",
    "Edit(plan.md)",
    "Edit(ARCHITECTURE.md)",
    "run_verification"
  ],
  "deny": [
    "Read(.env)",
    "Read(secrets/**)",
    "Bash(rm -rf /*)",
    "Bash(rm -rf *)",
    "Bash(*rm -rf*)",
    "Bash(*:(){ :|:& };:*)",
    "Bash(*mkfs*)",
    "Bash(*dd if=*)",
    "Bash(*format c:*)",
    "Bash(*shutdown*)",
    "Bash(*reboot*)"
  ]
}
