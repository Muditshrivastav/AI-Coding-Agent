# .env.example - Template for environment variables
# Copy this file to .env and fill in your actual credentials

# External APIs
tavily_api_key="tvly-your-tavily-api-key"
render_api_key="rnd_your-render-api-key"

# GitHub OAuth App credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Supabase database & project credentials
supabase_uri="postgresql://postgres:your-password@your-host:5432/postgres"
supabase_url="https://your-project.supabase.co"
supabase_anon_key="your-anon-key"
supabase_service_role="your-service-role-key"

# LangSmith tracing & evaluation credentials (https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="lsv2_pt_your-key-here"
LANGSMITH_PROJECT="agentic-coder"

LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="lsv2_pt_your-key-here"
LANGCHAIN_PROJECT="agentic-coder"

# Neo4j GraphRAG credentials
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-neo4j-password"
NEO4J_DATABASE="neo4j"

# GitHub Personal Access Token (for LlamaIndex repository ingestion)
GITHUB_TOKEN=""